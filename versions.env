# Pinned upstream versions. Single source of truth for local and CI builds.

# renovate: datasource=docker depName=debian
DEBIAN_IMAGE=debian:13.7-slim

# renovate: datasource=git-refs depName=https://github.com/richfelker/musl-cross-make branch=master
MUSL_CROSS_MAKE_REF=5e8042e63de29f8473fc3b0b831a587ba284e1a8
GCC_VER=15.1.0
MUSL_VER=1.2.6
BINUTILS_VER=2.44
LINUX_VER=6.15.7

# renovate: datasource=github-releases depName=strace/strace
STRACE_VERSION=v7.3

# renovate: datasource=github-releases depName=lsof-org/lsof
LSOF_VERSION=4.99.7
# lsof releases aren't signed: update this by hand with LSOF_VERSION.
LSOF_SHA256=4a10391aab0b8ce1f539e82a1966693b2a6cf225972a6504ebb7ec4fa71675de

# renovate: datasource=github-tags depName=zsh-users/zsh versioning=regex:^zsh-(?<major>\d+)\.(?<minor>\d+)(\.(?<patch>\d+))?$
ZSH_VERSION=zsh-5.9.2
# Built as a library for zsh and bash. Release tags look like v6_6; the regex skips
# the weekly snapshot tags (v6_6_YYYYMMDD).
# renovate: datasource=github-tags depName=ThomasDickey/ncurses-snapshots versioning=regex:^v(?<major>\d+)_(?<minor>\d+)$
NCURSES_VERSION=v6_6

# renovate: datasource=git-tags depName=https://git.savannah.gnu.org/git/bash.git versioning=regex:^bash-(?<major>\d+)\.(?<minor>\d+)$
BASH_VERSION=bash-5.3
# Number of upstream fix patches (bash53-001 ...) to apply. Not tracked by
# Renovate: check https://ftp.gnu.org/gnu/bash/ by hand, and reset to 0 when
# BASH_VERSION changes.
BASH_PATCHLEVEL=20

# socat's git repo (repo.or.cz) has no tag datasource here, so follow Alpine's
# package via Repology.
# renovate: datasource=repology depName=alpine_edge/socat versioning=loose
SOCAT_VERSION=1.8.1.3
# socat releases aren't signed: update this by hand with SOCAT_VERSION.
SOCAT_SHA256=06602ffd591e98c75b3dc1d66f0f19136cc666b0b2d95caad987d6ab2cb28097
# Built as a library for socat. The regex keeps to the 3.5 LTS branch.
# renovate: datasource=github-releases depName=openssl/openssl versioning=regex:^openssl-(?<major>3)\.(?<minor>5)\.(?<patch>\d+)$
OPENSSL_VERSION=openssl-3.5.9

# renovate: datasource=github-releases depName=jqlang/jq
JQ_VERSION=jq-1.8.2
# jq releases aren't signed: update this by hand with JQ_VERSION.
JQ_SHA256=71b8d6e8f5fe81f6c6d0d110e3892251f6ce76ed095abd315e26e6e1193af3af
# Built as a library for jq's regex functions. Upstream (kkos/oniguruma) was
# archived in 2025, so this is its final release and isn't tracked by Renovate.
ONIGURUMA_VERSION=6.9.10
ONIGURUMA_SHA256=2a5cfc5ae259e4e97f86b68dfffc152cdaffe94e2060b770cb827238d769fc05
