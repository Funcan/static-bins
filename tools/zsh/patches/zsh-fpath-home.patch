--- a/Src/init.c
+++ b/Src/init.c
@@ -1041,6 +1041,18 @@
 #  endif
 # endif
     *fpathptr = NULL;
+    /* static-bins: expand a leading ~/ to $HOME, so the default fpath can be
+     * relative to the user's home directory. */
+    {
+	char *home = getenv("HOME");
+	if (home && *home)
+	    for (fpathptr = fpath; *fpathptr; fpathptr++)
+		if ((*fpathptr)[0] == '~' && (*fpathptr)[1] == '/') {
+		    char *expanded = bicat(home, *fpathptr + 1);
+		    zsfree(*fpathptr);
+		    *fpathptr = expanded;
+		}
+    }
 #else /* FPATH_NEEDS_INIT */
     fpath    = mkarray(NULL);
 #endif /* FPATH_NEEDS_INIT */
